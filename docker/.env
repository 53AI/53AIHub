COMPOSE_PROJECT_NAME=53ai-hub
HUB_VERSION=v0.2.4
HUB_SERVER=prod
DEBUG=true
PORT=3000
SQL_DSN=agent:agentpassword@tcp(mysql:3306)/53ai_hub?charset=utf8mb4&parseTime=True&loc=UTC
REDIS_CONN=redis://:your_redis_password@redis:6379/0
MAX_UPLOAD_FILE_SIZE=15MB

# --- 安全配置（必填）---
# JWT 签名密钥。留空时服务会拒绝启动：缺失它会回落到源码中公开的默认值，
# 任何人都能据此伪造出通过校验的 token。生成方式：openssl rand -hex 32
JWT_SECRET=
# 沙盒文件下载 token 的独立签名密钥（可选）。留空则回落到 JWT_SECRET。
SANDBOX_DOWNLOAD_TOKEN_SECRET=
# oss
#STORAGE=aliyun_oss
ALIYUN_OSS_BUCKET_NAME=your_bucket_name
ALIYUN_OSS_ENDPOINT=oss-cn-region.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret
#BASE_PATH=agent_hub_test/static/uploads

# 可选值: NONE, ERROR, WARN, INFO, DEBUG
# NONE: 不输出任何日志
# ERROR: 只输出错误和致命错误日志
# WARN: 输出警告、错误和致命错误日志
# INFO: 输出信息、警告、错误和致命错误日志（默认）
# DEBUG: 输出所有日志
LOG_LEVEL=INFO

WEWORK_SUITE_ID=

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@yourdomain.com
SMTP_IS_SSL=true


DEPLOYMENT_MODE=local