+type CellAlign = 'left' | 'center' | 'right' | null
+const parseCellAlign = (cell: string): CellAlign => {
+  const t = cell.trim()
+  const left = t.startsWith(':')
+  const right = t.endsWith(':')
+  if (left && right) return 'center'
+  if (right) return 'right'
+  if (left) return 'left'
+  return null
+}
