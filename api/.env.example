HUB_VERSION=v0.1.0
HUB_SERVER=prod
DEBUG=true
PORT=9001
SQL_DSN=username:password@tcp(localhost:3306)/53ai_hub?charset=utf8mb4&parseTime=True&loc=UTC
REDIS_CONN=redis://:password@localhost:6379/0
MAX_UPLOAD_FILE_SIZE=15MB

# 文档上传配置
DOCUMENT_SINGLE_FILE_MAX_SIZE=500MB
DOCUMENT_UPLOAD_MAX_CONCURRENT=5
DOCUMENT_UPLOAD_CHUNK_SIZE=5MB
# oss
#STORAGE=aliyun_oss
ALIYUN_OSS_BUCKET_NAME=your_bucket_name
ALIYUN_OSS_ENDPOINT=oss-cn-region.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret
#BASE_PATH=agent_hub_test/static/uploads

# 可选值: NONE, ERROR, WARN, INFO, DEBUG
# NONE: 不输出任何日志
# ERROR: 只输出错误和致命错误日志
# WARN: 输出警告、错误和致命错误日志
# INFO: 输出信息、警告、错误和致命错误日志（默认）
# DEBUG: 输出所有日志
LOG_LEVEL=INFO
# 单机日志检索 UI 的全局鉴权 token（可选，支持多租户 SaaS 统一查看）
FILE_LOG_VIEWER_ACCESS_TOKEN=

# 慢日志记录开关（默认关闭。开启后慢接口/慢查询会异步入库，每条只记录一次，支持去重）
SLOW_LOG_ENABLED=false
# 慢接口阈值（毫秒，默认1000ms）
SLOW_API_THRESHOLD_MS=1000
# 慢查询阈值（毫秒，默认200ms）
SLOW_SQL_THRESHOLD_MS=200
# 慢日志缓冲队列大小（默认256）
SLOW_LOG_BUFFER_SIZE=256
# 慢日志异步写入协程数（默认2）
SLOW_LOG_WORKER_COUNT=2

WEWORK_SUITE_ID=

# SMS Configuration (短信配置)
SMS_ENABLED=false
SMS_PROVIDER=253chuanglan
SMS_ACCOUNT=
SMS_PASSWORD=
SMS_SIGN_NAME=博思协创
SMS_CODE_LENGTH=4
SMS_EXPIRY_TIME=15

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@yourdomain.com

VECTOR_DB_TYPE=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=API_KEY

# 数据库连接池配置
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=3600
DB_CONN_MAX_IDLE_TIME_SECONDS=600


# saas, local
DEPLOYMENT_MODE=

ELASTICSEARCH_ADDRESSES=http://localhost:9200

# Elasticsearch 用户名密码（可选）
LASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_DISABLED=false

DINGTALK_SUITE_ID=

# 前端传输流是否压缩
SSE_STREAM_MODE=compact

# 沙盒服务地址
# SANDBOX_SERVICE_URL="http://localhost:10801"
#
# 沙盒运行时开关（与部署开关分离）:
# - all: 默认，所有会话可用 sandbox 工具
# - off: 禁用 sandbox 工具，run_shell/read_file/write_file/list_files/code-interpreter 将 fail-closed
# - non-main: 预留模式（当前等价于 all）
SANDBOX_MODE=all
#
# 预留给后续 run scope / snapshot / gating 的基础契约参数
SANDBOX_SCOPE=session
SANDBOX_WORKSPACE_ACCESS=rw

# 走新加的 Docker workspace runtime，去掉则走原来的SANDBOX_SERVICE_URL
SANDBOX_RUNTIME_PROVIDER=docker
SANDBOX_RUNTIME_IMAGE=53aihub-sandbox:latest
# 沙盒文件对应宿主机上的目录
SANDBOX_RUNTIME_WORKSPACE_ROOT=/tmp/53aihub-sandbox
# 是Docker 容器里的目录
SANDBOX_RUNTIME_CONTAINER_WORKDIR=/workspace
# 沙盒空闲多久自动回收（秒），默认 3600
SANDBOX_RUNTIME_IDLE_CLEANUP_SECONDS=3600
# Agent 运行安全限制
# 最大循环次数，未配置时默认15；这里显式配置为20
AGENT_MAX_TURNS=20
# 最大循环次数硬上限，默认30
AGENT_MAX_TURNS_HARD_LIMIT=30
# 单次 Agent 运行最大墙上时间（秒），默认900（15分钟）
AGENT_MAX_WALL_CLOCK_SECONDS=900
# 检测到相同工具调用的最大重复次数，默认3
AGENT_MAX_REPEATED_TOOL_CALLS=3
# 连续工具调用失败次数达到该值后终止，默认3
AGENT_MAX_CONSECUTIVE_TOOL_FAILURES=3

# Agent 工具可靠性增强灰度开关
# 总开关：默认关闭。关闭时使用旧版 Agent 工具执行路径；开启后才会读取下面的子开关，
# 以及企业配置、Agent Settings 和 Skill frontmatter 中的 agent_tool_features 覆盖配置。
# 修改环境变量后需要重启服务；建议先只开启低风险子功能，再逐步扩大灰度范围。
AGENT_SUCCESS_RATE_ENHANCEMENTS_ENABLED=false

# 工具执行流水线：统一工具调用前后的处理流程
AGENT_TOOL_PIPELINE_ENABLED=false
# 工具输入防护：校验和拦截不符合约束的工具输入
AGENT_TOOL_INPUT_GUARD_ENABLED=false
# 统一工具结果：统一工具成功、失败和异常结果的返回结构
AGENT_UNIFIED_TOOL_RESULT_ENABLED=false
# 结构化 Provider 重试：对可重试的模型/Provider 响应进行结构化重试
AGENT_STRUCTURED_PROVIDER_RETRY_ENABLED=false
# 完成策略：根据工具执行状态判断 Agent 是否可以结束本轮运行
AGENT_COMPLETION_POLICY_ENABLED=false
# 读取续接：在读取结果不完整时继续读取，减少截断结果影响
AGENT_READ_CONTINUATION_ENABLED=false
# 工具参数适配：兼容和规范化模型生成的工具参数
AGENT_TOOL_ARGUMENT_ADAPTER_ENABLED=false
# Edit V2：启用新版编辑工具实现
AGENT_EDIT_V2_ENABLED=false
# 编辑规范化匹配：编辑前对目标文本进行规范化匹配
AGENT_EDIT_NORMALIZED_MATCH_ENABLED=false
# 编辑批处理：支持将多个编辑操作合并处理
AGENT_EDIT_BATCH_ENABLED=false
# Shell 输出 V2：启用新版 Shell 输出收集和返回逻辑
AGENT_RUN_SHELL_OUTPUT_V2_ENABLED=false

# 并发检索设置默认是4、3、3
RAG_MULTI_LIBRARY_SEARCH_MAX_CONCURRENT=4
RAG_COLLECTION_SEARCH_MAX_CONCURRENT=3
RAG_SEARCH_ENGINE_MAX_WORKERS=3

# 文档转换服务 (file-service) 配置
# 指向 file-service 的 base URL，用于文档解析（builtin/opendataloader/第三方引擎）
# DOC_CONVERT_BASE_URL=http://file-service:5022
# DOC_CONVERT_API_KEY=your_api_key
# 单次转换超时秒数（默认 1800，OpenDataLoader 复杂 PDF 建议增大）
# DOC_CONVERT_TIMEOUT=3600
# DOC_CONVERT_POLL_TIMEOUT=3600
# DOC_CONVERT_POLL_INTERVAL=5
# DOC_CONVERT_RETRY_TIMES=3
# DOC_CONVERT_MAX_FILE_SIZE=1GB
